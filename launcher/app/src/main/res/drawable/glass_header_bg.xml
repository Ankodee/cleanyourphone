<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#20000000" />
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>

    <!-- Frosted Glass Card with Specular Gradient Edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:endColor="#40FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:startColor="#2DFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
