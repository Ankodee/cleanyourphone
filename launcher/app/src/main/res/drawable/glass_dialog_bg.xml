<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#40000000" />
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:startColor="#E6252932"
                android:endColor="#F21C2028"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#44FFFFFF" />
        </shape>
    </item>
</layer-list>
