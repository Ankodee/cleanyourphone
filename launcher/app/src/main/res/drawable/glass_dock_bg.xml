<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Drop Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <solid android:color="#26000000" />
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp" />
        </shape>
    </item>

    <!-- Translucent Liquid Glass Fill with Specular Rim Highlight -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="90"
                android:startColor="#33FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#45FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.4dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
