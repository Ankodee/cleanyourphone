<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow / Ambient Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <solid android:color="#26000000" />
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>

    <!-- Frosted Glass Fill with Specular Edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient
                android:angle="90"
                android:endColor="#45FFFFFF"
                android:centerColor="#26FFFFFF"
                android:startColor="#33FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#77FFFFFF" />
        </shape>
    </item>
</layer-list>
