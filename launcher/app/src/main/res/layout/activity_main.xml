<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".MainActivity">

    <!-- 0. Optical Glass Unlock Transition Layer -->
    <ImageView
        android:id="@+id/unlock_blur_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 1. Horizontal SpringBoard Pager -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/horizontal_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="135dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- 2. Bottom Controls Container: Dots Indicator + Minimalist Search Bar -->
    <LinearLayout
        android:id="@+id/indicator_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/dock_container"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Page Indicator Dots -->
        <LinearLayout
            android:id="@+id/dots_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="3dp" />

        <!-- Minimal Search Bar -->
        <LinearLayout
            android:id="@+id/btn_search_pill"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_pill_height"
            android:layout_marginStart="@dimen/search_pill_margin_horiz"
            android:layout_marginEnd="@dimen/search_pill_margin_horiz"
            android:layout_marginTop="5dp"
            android:background="@drawable/glass_pill_search"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/search_icon_view"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_search"
                android:tint="@color/text_muted"
                android:contentDescription="Search Icon" />

            <TextView
                android:id="@+id/search_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Search apps..."
                android:textColor="@color/text_muted"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Bottom Minimal Floating Dock -->
    <FrameLayout
        android:id="@+id/dock_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/dock_margin"
        android:paddingEnd="@dimen/dock_margin"
        android:paddingBottom="@dimen/dock_bottom_margin">

        <LinearLayout
            android:id="@+id/glass_dock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_height"
            android:background="@drawable/glass_dock_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_dock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </FrameLayout>

    <!-- 4. Spotlight Search Overlay -->
    <RelativeLayout
        android:id="@+id/spotlight_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/search_overlay_dark"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Top Search Bar Container -->
        <LinearLayout
            android:id="@+id/spotlight_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/spotlight_input_height"
                android:layout_weight="1"
                android:background="@drawable/glass_search_input_bg"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_muted"
                    android:contentDescription="Search Icon" />

                <EditText
                    android:id="@+id/spotlight_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Search apps..."
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_cancel_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Cancel"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Live Instant Search Results -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/spotlight_header"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    </RelativeLayout>

</RelativeLayout>
