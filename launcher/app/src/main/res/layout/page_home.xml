<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp">

    <!-- Refined Medium Clock & Date Header (Integrated, Zero Clunky Containers) -->
    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <!-- Medium Refined Digital Clock -->
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/clock_text_size"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false"
            android:shadowColor="@color/shadow_color"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Sub-row: Date & Subtle Battery Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextClock
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/date_text_size"
                android:fontFamily="sans-serif"
                android:shadowColor="@color/shadow_color"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/widget_divider_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   •   "
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_battery_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_battery"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Battery" />

                <TextView
                    android:id="@+id/text_battery_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="100%"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif"
                    android:shadowColor="@color/shadow_color"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- App Grid for Page 0 (Spacious 8-app layout, zero duplicates with dock) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/page_app_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:clipToPadding="false" />

</LinearLayout>
