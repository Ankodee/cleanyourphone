<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="28dp">

    <!-- iOS Frosted Glass Smart Widget (4x2 Apple-style card) -->
    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_card_height"
        android:layout_marginStart="@dimen/widget_margin_horiz"
        android:layout_marginEnd="@dimen/widget_margin_horiz"
        android:layout_marginTop="@dimen/widget_margin_top"
        android:layout_marginBottom="@dimen/widget_margin_bottom"
        android:background="@drawable/glass_widget_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <!-- Left: Clock & Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/clock_text_size"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:shadowColor="@color/shadow_color"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextClock
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/date_text_size"
                android:fontFamily="sans-serif"
                android:layout_marginTop="4dp"
                android:shadowColor="@color/shadow_color"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />
        </LinearLayout>

        <!-- Right: iOS Battery & Clean Status Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/glass_pill_search"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_battery"
                    android:contentDescription="Battery" />

                <TextView
                    android:id="@+id/text_battery_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="85%"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Liquid Glass"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- App Grid for Page 0 (4 columns x 4 rows) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/page_app_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:clipToPadding="false" />

</LinearLayout>
