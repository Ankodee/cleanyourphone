# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit shell scripts
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.apk binary
